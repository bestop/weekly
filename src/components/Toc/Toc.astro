---
import TocItem from './TocItem.astro';
const { headings } = Astro.props;
const toc = buildToc(headings);

function buildToc(headings) {
  const toc = [];
  const parentHeadings = new Map();
  headings.forEach((h) => {
    const heading = { ...h, subheadings: [] };
    parentHeadings.set(heading.depth, heading);
    if (heading.depth === 2) {
      toc.push(heading);
    } else {
      // 防御：h3 先于 h2（或 h4 先于 h3）出现时，父级不存在，挂到最近一个 h2 上，避免构建崩溃
      const parent = parentHeadings.get(heading.depth - 1) || toc[toc.length - 1];
      if (parent) parent.subheadings.push(heading);
    }
  });
  return toc;
}
---

<nav class="g-toc" id="Jtoc">
  <h5>TOC</h5>
  <ul class="toc-list">
    {toc.map((heading) => <TocItem heading={heading} />)}
  </ul>
</nav>